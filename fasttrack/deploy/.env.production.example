# FastTrack Team Logistics: production settings for cPanel.
# Copy to /home/fstremov/fasttrack/.env and fill in the blanks.
APP_NAME="FastTrack Team Logistics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fstremoval.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Database Wizard. Names are prefixed with the cPanel username.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=fstremov_fasttrack
DB_USERNAME=fstremov_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# cPanel → Email Accounts: use the info@ mailbox to send quote emails.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.fstremoval.co.uk
MAIL_PORT=465
MAIL_USERNAME=info@fstremoval.co.uk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@fstremoval.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Business details shown on the site (replace the placeholders)
FASTTRACK_PHONE="020 0000 0000"
FASTTRACK_WHATSAPP=440000000000
FASTTRACK_EMAIL=info@fstremoval.co.uk
FASTTRACK_NOTIFY_EMAIL=info@fstremoval.co.uk
