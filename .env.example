# ── Backend API ───────────────────────────────────────────────────────────────
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production (set this in your hosting environment — Vercel, Netlify, etc.):
# NEXT_PUBLIC_API_URL=https://api.careaccess.ng

# ── Supabase (client-side auth only) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Paystack (public key only — secret lives in Backend) ─────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
# Production:
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
